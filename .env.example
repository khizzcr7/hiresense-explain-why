# HireSense Explain-Why — configuration template.
# Copy to .env (or export in your shell). .env is git-ignored. NEVER commit
# real keys, and never show keys on screen in the demo video.

# --- Power layer: Meterless Nightshift + NVIDIA Nemotron -------------------
# From your Meterless Nightshift workspace (NVIDIA Nemotron connected inside
# Nightshift). When all three are set, reasoning runs through Nightshift as
# the primary AI provider; otherwise the agent falls back to its local
# heuristic backend and says so in the reasoning trace.
NIGHTSHIFT_API_BASE_URL=
NIGHTSHIFT_API_KEY=
NIGHTSHIFT_MODEL=

# --- Data layer: Zetaris Lightning ----------------------------------------
# From your Zetaris Cloud console (gateway / "Verify SQL Connectivity" step
# of the Zetaris quick-start). When set, source federation is routed through
# Zetaris Lightning; otherwise the layer federates locally and says so.
ZETARIS_GATEWAY_URL=
ZETARIS_API_KEY=
ZETARIS_SQL_PATH=/sql

# --- Memory engine (H-MEM) -------------------------------------------------
# Path of the H-MEM store file. Defaults to .explain-why-memory.json in the
# working directory.
HMEM_PATH=
